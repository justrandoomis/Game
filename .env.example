# Reuses the Levonis platform credentials. Point the game at the same
# Cloudflare D1 database and the same JWT secret so player identity,
# Levonis Points and tickets stay in one place.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DATABASE_ID=your_database_id
CLOUDFLARE_API_TOKEN=your_api_token
JWT_SECRET=super_secret_jwt_key_123

# When the D1 variables above are absent the server falls back to a local
# JSON store under .data/ so the game runs standalone in development.
PF_DATA_DIR=.data
PORT=3000
