{
  "name": "levo-printer-farm-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Authoritative game backend for LEVO Printer Farm. The Godot client is in godot/.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "game:import": "godot --headless --path godot --import && godot --headless --path godot --import",
    "game:check": "npm run game:import && godot --headless --path godot -- --selftest",
    "game:export:web": "godot --headless --path godot --export-release Web ../client/web/index.html"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.5"
  }
}
