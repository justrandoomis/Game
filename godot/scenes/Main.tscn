[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/farm/Farm.tscn" id="2_farm"]
[ext_resource type="PackedScene" path="res://scenes/ui/TopHUD.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/BottomNav.tscn" id="4_nav"]
[ext_resource type="PackedScene" path="res://scenes/ui/TutorialHint.tscn" id="5_hint"]
[ext_resource type="PackedScene" path="res://scenes/ui/FxLayer.tscn" id="6_fx"]

[sub_resource type="GDScript" id="GDScript_bg"]
script/source = "extends ColorRect
## The sky behind the workshop. A flat wash rather than a gradient, so it never
## competes with the farm and costs nothing to draw.


func _ready() -> void:
	color = Palette.SKY_SOFT
	set_anchors_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
"

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Sky" type="CanvasLayer" parent="."]
layer = -100

[node name="Background" type="ColorRect" parent="Sky"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_bg")

[node name="Farm" parent="." instance=ExtResource("2_farm")]

[node name="UI" type="CanvasLayer" parent="."]

[node name="Screens" type="MarginContainer" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 62.0
grow_horizontal = 2
grow_vertical = 2

[node name="Tutorial" parent="UI" instance=ExtResource("5_hint")]

[node name="TopHUD" parent="UI" instance=ExtResource("3_hud")]

[node name="BottomNav" parent="UI" instance=ExtResource("4_nav")]

[node name="Sheets" type="MarginContainer" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Fx" parent="UI" instance=ExtResource("6_fx")]

[node name="Boot" type="Control" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
